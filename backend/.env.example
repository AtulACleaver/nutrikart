# Database Connection URL
# For local SQLite development (zero-config, works out of the box):
DATABASE_URL=sqlite:///./nutrikart.db

# For PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Allowed CORS origins (comma-separated, default is * for local dev)
ALLOWED_ORIGINS=*

# ILP Optimizer flag
LP_AVAILABLE=true
